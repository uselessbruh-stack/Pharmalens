{
  "dataset": "NonKinasePanel",
  "dataset_version": "202610_v2",
  "endpoint": "Kd",
  "input": "data/processed/prepared/nonkinase_kd_202610_v2/Kd.csv",
  "preprocessing_version": "standardized_v1",
  "model": "deeptda",
  "model_params": {
    "drug_max_len": 150,
    "protein_max_len": 1500,
    "drug_embed_dim": 64,
    "protein_embed_dim": 64,
    "num_filters": 32,
    "fc_dims": [
      512,
      256
    ],
    "dropout": 0.1,
    "mask_padding": true,
    "deduplicate_proteins": true,
    "auxiliary_dim": 1454
  },
  "split": "random",
  "split_seed": 42,
  "seed": 42,
  "training": {
    "threads": 2,
    "epochs": 80,
    "patience": 15,
    "batch_size": 64,
    "learning_rate": 0.001,
    "weight_decay": 0.0001,
    "normalize_targets": true
  },
  "smoke": false
}
